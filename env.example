# ============================================================
# Chatwork Export CLI 環境変数サンプル
# このファイルを env にコピーして値を埋めてください。
#   cp env.example env
# env は .gitignore 済みです。絶対にコミットしないでください。
# ============================================================

# [必須] Chatwork API トークン
# 取得方法: Chatwork Web版 → 右上アイコン → サービス連携 → API Token
CHATWORK_API_TOKEN=

# [任意] 自分の account_id
# --mine で使用します。未設定の場合は GET /me から自動取得します（1リクエスト消費）。
# `npm run me` で確認できます。
CHATWORK_MY_ACCOUNT_ID=

# [任意] API のベース URL（通常は変更不要）
CHATWORK_API_BASE=https://api.chatwork.com/v2

# [任意] 日付の解釈に使うタイムゾーンオフセット（既定 +09:00 = JST）
# --from / --to の YYYY-MM-DD をこのオフセットの 00:00:00〜23:59:59 として扱います。
CHATWORK_TZ_OFFSET=+09:00

# [任意] レート制限設定（既定は Chatwork の公称値 300回 / 5分）
CHATWORK_RATE_LIMIT=300
CHATWORK_RATE_WINDOW_SEC=300

# [任意] リクエスト間の最小待機時間(ms)。
# force=1 でのメッセージ取得は公称値より厳しく絞られることがあるため、既定で少し間隔を空けます。
CHATWORK_MIN_INTERVAL_MS=250

# [任意] リトライ回数（429 / 5xx / ネットワークエラー時）
CHATWORK_MAX_RETRIES=5

# ============================================================
# Slack
# ============================================================

# [必須] Slack のトークン
# SLACK_TOKEN / SLACK_USER_TOKEN / SLACK_BOT_TOKEN の順に見ます
# （slack-chat-hub と同じキー名も受け付けます。ユーザートークンを優先）
#
# 重要: ワークスペース内製アプリ（自分たちで作った内部アプリ）を使ってください。
#   内部アプリ … 50+ リクエスト/分、1回1000件まで
#   Marketplace 未掲載の配布アプリ … 1リクエスト/分、1回15件（2026-03-03 以降）
#
# 必要なスコープ:
#   channels:history, channels:read      パブリックチャンネル
#   groups:history,   groups:read        プライベートチャンネル
#   im:history,       im:read            DM（必要な場合）
#   mpim:history,     mpim:read          グループDM（必要な場合）
#   users:read                           ユーザー名の解決
SLACK_TOKEN=

# [任意] 自分の Slack ユーザーID
# --mine で使用します。未設定の場合は auth.test から自動取得します。
# `npm run me:slack` で確認できます。
SLACK_MY_USER_ID=

# [任意] API のベース URL（通常は変更不要）
SLACK_API_BASE=https://slack.com/api

# [任意] レート制限設定（既定は内部アプリ想定の 50回/60秒）
SLACK_RATE_LIMIT=50
SLACK_RATE_WINDOW_SEC=60
SLACK_MIN_INTERVAL_MS=200
SLACK_MAX_RETRIES=5
