{
  "name": "management-chat-data",
  "version": "0.1.0",
  "private": true,
  "description": "Chatwork / Slack / Gmail のやり取りを期間指定でエクスポートする CLI",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "export": "tsx src/cli/export.ts",
    "rooms": "tsx src/cli/rooms.ts",
    "me": "tsx src/cli/me.ts",
    "export:slack": "tsx src/cli/export-slack.ts",
    "channels": "tsx src/cli/channels.ts",
    "me:slack": "tsx src/cli/me-slack.ts",
    "export:gmail": "tsx src/cli/export-gmail.ts",
    "gmail:auth": "tsx src/cli/gmail-auth.ts",
    "labels": "tsx src/cli/labels.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
